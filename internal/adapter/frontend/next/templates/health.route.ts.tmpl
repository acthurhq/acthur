// GET /health — Acthur's health checker polls this and parses the JSON body.
// Response shape matches every service adapter (go:fiber, rust:axum,
// node:fastify, ui:astro, ...) so the kernel's health poller is
// framework-agnostic. App Router route handlers run on the Node.js runtime
// by default, so this works identically under `next dev` and the built
// standalone server.
import { NextResponse } from 'next/server';

const startTime = process.hrtime.bigint();

function uptimeSeconds(): number {
  const now = process.hrtime.bigint();
  return Number(now - startTime) / 1e9;
}

/**
 * GET handles GET /health.
 * Returns 200 if all checks pass, 503 if any fail.
 */
export async function GET() {
  // Checks added here by migrations plugin, auth plugin, etc.
  const checks: Record<string, { status: string }> = {};

  let status = 'healthy';
  let httpStatus = 200;
  for (const key of Object.keys(checks)) {
    if (checks[key].status !== 'healthy') {
      status = 'degraded';
      httpStatus = 503;
      break;
    }
  }

  return NextResponse.json(
    {
      status,
      service: '{{.NodeID}}',
      uptime_seconds: uptimeSeconds(),
      checks,
    },
    { status: httpStatus }
  );
}
