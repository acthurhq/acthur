# syntax=docker/dockerfile:1
# Generated by Acthur for ui:next
# Project: {{.ProjectName}} — Service: {{.NodeID}}

# -- Build stage ---------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /build

# Download dependencies first (better layer caching)
COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build

# -- Run stage -----------------------------------------------------------------
FROM node:24-alpine

WORKDIR /app
# output: 'standalone' traces only what's needed at runtime into
# .next/standalone (including a minimal node_modules) — no full npm install
# needed in the runtime stage.
COPY --from=builder /build/.next/standalone ./
COPY --from=builder /build/.next/static ./.next/static
COPY --from=builder /build/public ./public

EXPOSE 3000

USER node
ENTRYPOINT ["node", "server.js"]
