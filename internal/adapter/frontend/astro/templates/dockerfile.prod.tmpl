# syntax=docker/dockerfile:1
# Generated by Acthur (deploy/artifacts) for ui:astro node "{{.NodeID}}".
# Distinct from the scaffold-time Dockerfile: this one is re-rendered on
# every `acthur deploy` from the node's current graph facts.

# -- Build stage ---------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build

# -- Run stage -----------------------------------------------------------------
FROM node:24-alpine

RUN addgroup -S acthur && adduser -S acthur -G acthur
WORKDIR /app
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/package.json ./
{{if .Port}}
EXPOSE {{.Port}}
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD wget -qO- http://127.0.0.1:{{.Port}}/health || exit 1
ENV PORT={{.Port}}
{{end}}
USER acthur
ENTRYPOINT ["node", "./dist/server/entry.mjs"]
