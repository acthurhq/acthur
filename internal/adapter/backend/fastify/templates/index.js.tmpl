import Fastify from 'fastify';
import cors from '@fastify/cors';
import compress from '@fastify/compress';

import * as config from './config.js';
import { errorHandler } from './errors.js';
import { registerRoutes } from './routes.js';

const cfg = config.load();

// Middleware is registered here in a fixed order:
//  1. Logger        (structured request logging — method, path, status, latency)
//  2. CORS           (generated from graph data_flow edges by security plugin)
//  3. Compress
//  4. Routes
//  5. Error handler
const app = Fastify({
  logger: {
    level: config.isDevelopment(cfg) ? 'info' : 'warn',
  },
  disableRequestLogging: false,
});

await app.register(cors, { origin: cfg.corsOrigins });
await app.register(compress);
await registerRoutes(app, cfg);
app.setErrorHandler(errorHandler);

async function start() {
  try {
    await app.listen({ port: Number(cfg.port), host: '0.0.0.0' });
  } catch (err) {
    app.log.error(err);
    process.exit(1);
  }
}

// Graceful shutdown
for (const signal of ['SIGINT', 'SIGTERM']) {
  process.on(signal, async () => {
    app.log.info('shutting down...');
    await app.close();
    process.exit(0);
  });
}

start();
