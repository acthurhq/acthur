// Project-wide ID generation strategy: UUIDv4. Generated by Acthur —
// change the strategy in acthur.yml identifiers.strategy.
//
// IMPORTANT: Always use ids.new() — never generate IDs ad hoc.

import { randomUUID } from 'node:crypto';

/** new generates a new UUIDv4 identifier. */
export function newId() {
  return randomUUID();
}

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

/** validate returns true if the given string is a valid UUID. */
export function validate(id) {
  return typeof id === 'string' && UUID_RE.test(id);
}

export const ZERO = '00000000-0000-0000-0000-000000000000';
