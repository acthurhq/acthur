// Project-wide ID generation strategy: ULID — sortable, URL-safe,
// collision-resistant. Generated by Acthur — change the strategy in
// acthur.yml identifiers.strategy.
//
// IMPORTANT: Always use ids.new() — never generate IDs ad hoc.
//
// Self-contained Crockford-base32 ULID implementation (no external
// dependency): 48-bit millisecond timestamp + 80 bits of randomness.

import { randomBytes } from 'node:crypto';

const ENCODING = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
const ENCODING_LEN = ENCODING.length;
const TIME_LEN = 10;
const RANDOM_LEN = 16;

function encodeTime(now) {
  let mod;
  let str = '';
  let n = now;
  for (let i = TIME_LEN - 1; i >= 0; i--) {
    mod = n % ENCODING_LEN;
    str = ENCODING.charAt(mod) + str;
    n = Math.floor(n / ENCODING_LEN);
  }
  return str;
}

function encodeRandom() {
  const bytes = randomBytes(RANDOM_LEN);
  let str = '';
  for (let i = 0; i < RANDOM_LEN; i++) {
    str += ENCODING.charAt(bytes[i] % ENCODING_LEN);
  }
  return str;
}

/** new generates a new ULID identifier. */
export function newId() {
  return encodeTime(Date.now()) + encodeRandom();
}

const ULID_RE = /^[0-9A-HJKMNP-TV-Z]{26}$/;

/** validate returns true if the given string is a valid ULID. */
export function validate(id) {
  return typeof id === 'string' && ULID_RE.test(id);
}

export const ZERO = '00000000000000000000000000';
