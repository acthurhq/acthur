# syntax=docker/dockerfile:1
# Generated by Acthur (deploy/artifacts) for node:fastify node "{{.NodeID}}".
# Distinct from the scaffold-time Dockerfile: this one is re-rendered on
# every `acthur deploy` from the node's current graph facts.

# -- Build stage ---------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

# -- Run stage -----------------------------------------------------------------
FROM node:24-alpine

WORKDIR /app
COPY --from=builder /build/node_modules ./node_modules
COPY package.json ./
COPY src ./src
{{if .Port}}
EXPOSE {{.Port}}
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD wget -qO- http://127.0.0.1:{{.Port}}/health || exit 1
{{end}}
USER node
ENTRYPOINT ["node", "src/index.js"]
