// Route registration for the node:fastify service.
// Generated handlers are wired here by the generator engine.
// Middleware order per route group (applied via Fastify hooks/plugins):
//  1. tenant middleware  (if multitenancy active)
//  2. auth middleware    (if auth plugin active)
//  3. rbac middleware    (if rbac plugin active)
//  4. handler

import { handler as healthHandler } from './health.js';

/**
 * registerRoutes wires all routes onto the Fastify app.
 * Health check — no auth, no tenant.
 * /api/health is the same handler reachable through the dev proxy, which
 * routes /api/* to this service without stripping the prefix.
 */
export async function registerRoutes(app, cfg) {
  const health = healthHandler(cfg.appName);
  app.get('/health', health);
  app.get('/api/health', health);

  // API v1 routes
  app.register(
    async function v1(v1app) {
      // Example (generated by: acthur generate from-contract users.contract.yml):
      // v1app.post('/users', usersHandler.create);
      // v1app.get('/users/:id', usersHandler.get);
      // v1app.get('/users', usersHandler.list);
      // v1app.put('/users/:id', usersHandler.update);
      // v1app.delete('/users/:id', usersHandler.remove);
      void v1app;
    },
    { prefix: '/api/v1' }
  );
}
