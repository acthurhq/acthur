//! Route registration for the rust:axum service.
//! Generated handlers are wired here by the generator engine.
//! Middleware order per route group (applied via axum layers/extractors):
//!  1. tenant middleware  (if multitenancy active)
//!  2. auth middleware    (if auth plugin active)
//!  3. rbac middleware    (if rbac plugin active)
//!  4. handler

use axum::{routing::get, Router};

use crate::{health, AppState};

/// register_routes builds the top-level router.
/// /health — no auth, no tenant.
/// /api/health is the same handler reachable through the dev proxy, which
/// routes /api/* to this service without stripping the prefix.
pub fn register_routes(state: AppState) -> Router {
    Router::new()
        .route("/health", get(health::handler))
        .route("/api/health", get(health::handler))
        // API v1 routes
        // Example (generated by: acthur generate from-contract users.contract.yml):
        // .route("/api/v1/users", post(users::create).get(users::list))
        // .route("/api/v1/users/:id", get(users::get).put(users::update).delete(users::delete))
        .with_state(state)
}
