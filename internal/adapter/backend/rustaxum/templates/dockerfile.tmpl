# -- Build stage ---------------------------------------------------------------
FROM rust:1.82-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build

# Download dependencies first (better layer caching)
COPY Cargo.toml Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

# Build
COPY . .
RUN touch src/main.rs && cargo build --release

# -- Run stage -----------------------------------------------------------------
FROM alpine:3.20

RUN addgroup -S acthur && adduser -S acthur -G acthur
COPY --from=builder /build/target/release/{{.NodeID}} /app

EXPOSE 8080

USER acthur
ENTRYPOINT ["/app"]
