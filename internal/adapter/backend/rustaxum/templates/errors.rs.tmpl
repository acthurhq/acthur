//! Standard error type for this service. All handlers should return an
//! AppError (via axum's IntoResponse) for consistent API responses.

use axum::{
    http::StatusCode,
    response::{IntoResponse, Response},
    Json,
};
use serde::Serialize;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Code {
    NotFound,
    Unauthorized,
    Forbidden,
    Validation,
    Conflict,
    Internal,
    BadRequest,
    RateLimit,
}

impl Code {
    fn as_str(&self) -> &'static str {
        match self {
            Code::NotFound => "not_found",
            Code::Unauthorized => "unauthorized",
            Code::Forbidden => "forbidden",
            Code::Validation => "validation_failed",
            Code::Conflict => "conflict",
            Code::Internal => "internal_error",
            Code::BadRequest => "bad_request",
            Code::RateLimit => "rate_limit_exceeded",
        }
    }
}

impl Serialize for Code {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer,
    {
        serializer.serialize_str(self.as_str())
    }
}

#[derive(Serialize)]
pub struct AppError {
    #[serde(skip)]
    pub http_status: StatusCode,
    pub code: Code,
    pub message: String,
}

impl AppError {
    pub fn not_found(resource: &str) -> Self {
        AppError {
            http_status: StatusCode::NOT_FOUND,
            code: Code::NotFound,
            message: format!("{resource} not found"),
        }
    }
    pub fn unauthorized(msg: impl Into<String>) -> Self {
        AppError {
            http_status: StatusCode::UNAUTHORIZED,
            code: Code::Unauthorized,
            message: msg.into(),
        }
    }
    pub fn validation(msg: impl Into<String>) -> Self {
        AppError {
            http_status: StatusCode::UNPROCESSABLE_ENTITY,
            code: Code::Validation,
            message: msg.into(),
        }
    }
    pub fn internal() -> Self {
        AppError {
            http_status: StatusCode::INTERNAL_SERVER_ERROR,
            code: Code::Internal,
            message: "an internal error occurred".to_string(),
        }
    }
}

impl IntoResponse for AppError {
    fn into_response(self) -> Response {
        let status = self.http_status;
        (status, Json(serde_json::json!({ "error": self }))).into_response()
    }
}
