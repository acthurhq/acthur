//! Configuration loaded from environment variables (set by Acthur at startup).
//! Generated by Acthur — do not hand-edit; re-scaffold to pick up adapter changes.

use std::env;

#[derive(Clone, Debug)]
pub struct Config {
    pub app_name: String,
    pub port: String,
    pub app_env: String,
    pub secret: String,
    pub database_url: String,
    pub redis_url: String,
    pub cors_origins: String,
}

impl Config {
    /// Load reads config from environment variables.
    /// Missing required variables cause a clear, immediate failure.
    pub fn load() -> Self {
        Config {
            app_name: get_env("APP_NAME", "{{.NodeID}}"),
            port: get_env("APP_PORT", "8080"),
            app_env: get_env("APP_ENV", "development"),
            secret: must_get_env("APP_SECRET"),
            database_url: must_get_env("DATABASE_URL"),
            redis_url: get_env("REDIS_URL", "redis://localhost:6379"),
            cors_origins: get_env("CORS_ORIGINS", "*"),
        }
    }

    pub fn is_development(&self) -> bool {
        self.app_env == "development"
    }

    pub fn is_production(&self) -> bool {
        self.app_env == "production"
    }
}

fn get_env(key: &str, fallback: &str) -> String {
    env::var(key).unwrap_or_else(|_| fallback.to_string())
}

fn must_get_env(key: &str) -> String {
    env::var(key).unwrap_or_else(|_| {
        panic!(
            "required environment variable {:?} is not set\n  Check your .env file or secrets provider.",
            key
        )
    })
}
