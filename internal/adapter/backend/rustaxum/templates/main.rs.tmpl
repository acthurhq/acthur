use std::time::Instant;

use tower_http::{
    compression::CompressionLayer,
    cors::{Any, CorsLayer},
    trace::TraceLayer,
};

use config::Config;

/// AppState is shared, cloneable state handed to every handler via axum's
/// State extractor.
#[derive(Clone)]
pub struct AppState {
    pub start: Instant,
    pub app_name: String,
}

#[tokio::main]
async fn main() {
    tracing_subscriber::fmt()
        .with_env_filter(
            tracing_subscriber::EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new("info")),
        )
        .init();

    let cfg = Config::load();

    let state = AppState {
        start: Instant::now(),
        app_name: cfg.app_name.clone(),
    };

    // Middleware is layered here in a fixed order (outermost first):
    //  1. TraceLayer   (structured request logging — method, path, status, latency)
    //  2. CORS         (generated from graph data_flow edges by security plugin)
    //  3. Compression
    //  4. Routes
    let cors = CorsLayer::new().allow_origin(Any);

    let app = routes::register_routes(state)
        .layer(TraceLayer::new_for_http())
        .layer(cors)
        .layer(CompressionLayer::new());

    let addr = format!("0.0.0.0:{}", cfg.port);
    let listener = tokio::net::TcpListener::bind(&addr)
        .await
        .unwrap_or_else(|e| panic!("failed to bind {addr}: {e}"));

    tracing::info!("{} listening on {}", cfg.app_name, addr);

    axum::serve(listener, app)
        .with_graceful_shutdown(shutdown_signal())
        .await
        .unwrap_or_else(|e| panic!("server error: {e}"));
}

/// shutdown_signal resolves on SIGTERM or Ctrl-C, letting axum drain
/// in-flight requests before the process exits.
async fn shutdown_signal() {
    let ctrl_c = async {
        tokio::signal::ctrl_c()
            .await
            .expect("failed to install Ctrl-C handler");
    };

    #[cfg(unix)]
    let terminate = async {
        tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
            .expect("failed to install SIGTERM handler")
            .recv()
            .await;
    };

    #[cfg(not(unix))]
    let terminate = std::future::pending::<()>();

    tokio::select! {
        _ = ctrl_c => {},
        _ = terminate => {},
    }

    tracing::info!("shutting down...");
}
