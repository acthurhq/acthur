# syntax=docker/dockerfile:1
# Generated by Acthur (deploy/artifacts) for rust:axum node "{{.NodeID}}".
# Distinct from the scaffold-time Dockerfile: this one is re-rendered on
# every `acthur deploy` from the node's current graph facts.

# -- Build stage ---------------------------------------------------------------
FROM rust:1.82-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build

COPY Cargo.toml Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

COPY . .
RUN touch src/main.rs && cargo build --release

# -- Run stage -----------------------------------------------------------------
FROM alpine:3.20

RUN addgroup -S acthur && adduser -S acthur -G acthur
COPY --from=builder /build/target/release/{{.NodeID}} /app
{{if .Port}}
EXPOSE {{.Port}}
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD wget -qO- http://127.0.0.1:{{.Port}}/health || exit 1
{{end}}
USER acthur
ENTRYPOINT ["/app"]
