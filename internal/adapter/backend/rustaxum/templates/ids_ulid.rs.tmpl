//! Project-wide ID generation strategy: ULID — sortable, URL-safe,
//! collision-resistant. Generated by Acthur — change the strategy in
//! acthur.yml identifiers.strategy.
//!
//! IMPORTANT: Always use ids::new() — never generate IDs ad hoc.

use ulid::Ulid;

pub type Id = String;

/// new generates a new ULID identifier.
pub fn new() -> Id {
    Ulid::new().to_string()
}

/// validate returns true if the given string is a valid ULID.
pub fn validate(id: &str) -> bool {
    Ulid::from_string(id).is_ok()
}

pub const ZERO: &str = "00000000000000000000000000";
