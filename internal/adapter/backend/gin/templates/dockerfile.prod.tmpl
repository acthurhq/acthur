# syntax=docker/dockerfile:1
# Generated by Acthur (deploy/artifacts) for go:gin node "{{.NodeID}}".
# Distinct from the scaffold-time Dockerfile: this one is re-rendered on
# every `acthur deploy` from the node's current graph facts.

# -- Build stage ---------------------------------------------------------------
FROM golang:1.22-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /build/app \
    .

# -- Run stage -----------------------------------------------------------------
FROM alpine:3.20

RUN addgroup -S acthur && adduser -S acthur -G acthur
COPY --from=builder /build/app /app
{{if .Port}}
EXPOSE {{.Port}}
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD wget -qO- http://127.0.0.1:{{.Port}}/health || exit 1
{{end}}
USER acthur
ENTRYPOINT ["/app"]
