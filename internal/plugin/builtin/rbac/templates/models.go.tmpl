// Package rbac provides role-based access control models and middleware,
// generated by Acthur's "rbac" plugin for go:fiber projects.
//
// ASSUMPTION: an upstream auth layer (the "auth" plugin's generated
// middleware, or your own) has already authenticated the request and stashed
// the authenticated user's id in the fiber context locals under the key
// "user_id" — see UserIDLocalsKey in middleware.go. This package never
// imports the auth plugin's generated code; it only reads that one
// well-known locals key. Mount RequireRole/RequirePermission after your
// authentication middleware.
package rbac

import "time"

// Role is a named collection of permissions a user can be assigned.
// Backed by the "roles" table (migration 0200_roles).
type Role struct {
	ID          string
	Name        string
	Description string
	CreatedAt   time.Time
}

// Permission is a single named capability a role can grant.
// Backed by the "permissions" table (migration 0201_permissions).
type Permission struct {
	ID          string
	Name        string
	Description string
	CreatedAt   time.Time
}

// UserRole links a user id (owned by the auth layer, not this package) to a
// Role. Backed by the "user_roles" table (migration 0202_user_roles).
type UserRole struct {
	UserID string
	RoleID string
}
