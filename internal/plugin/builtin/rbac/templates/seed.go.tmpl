// GrantPermissionToRole links roleID to permissionID in role_permissions,
// idempotently.
func GrantPermissionToRole(ctx context.Context, db DBPool, roleID, permissionID string) error {
	const q = `
		INSERT INTO role_permissions (role_id, permission_id)
		VALUES ($1, $2)
		ON CONFLICT DO NOTHING`
	_, err := db.Exec(ctx, q, roleID, permissionID)
	return err
}

// AssignRoleToUser links userID (owned by the auth layer) to roleID in
// user_roles, idempotently.
func AssignRoleToUser(ctx context.Context, db DBPool, userID, roleID string) error {
	const q = `
		INSERT INTO user_roles (user_id, role_id)
		VALUES ($1, $2)
		ON CONFLICT DO NOTHING`
	_, err := db.Exec(ctx, q, userID, roleID)
	return err
}
