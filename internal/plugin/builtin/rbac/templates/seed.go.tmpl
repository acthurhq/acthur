package rbac

import (
	"context"

	"{{.ModulePath}}/internal/ids"
)

// SeedRoles inserts each of names as a role (skipping ones that already
// exist by name) and returns the resulting id for every name. Call once
// during project bootstrap — see `acthur db seed`.
func SeedRoles(ctx context.Context, db DBPool, names ...string) (map[string]string, error) {
	out := make(map[string]string, len(names))
	for _, name := range names {
		const q = `
			INSERT INTO roles (id, name)
			VALUES ($1, $2)
			ON CONFLICT (name) DO UPDATE SET name = roles.name
			RETURNING id`
		var gotID string
		if err := db.QueryRow(ctx, q, ids.New(), name).Scan(&gotID); err != nil {
			return nil, err
		}
		out[name] = gotID
	}
	return out, nil
}

