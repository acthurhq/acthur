// Package auth is generated by Acthur's built-in "auth" plugin.
// It provides JWT issue/verify, a DB-backed session store, a magic-link
// token flow, and an OAuth2 provider registry for a go:fiber service.
package auth

import "time"

// User is the row shape of the users table (migrations/0100_users.up.sql).
type User struct {
	ID           string
	Email        string
	PasswordHash string
	CreatedAt    time.Time
}

// Session is the row shape of the sessions table (migrations/0101_sessions.up.sql).
type Session struct {
	Token     string
	UserID    string
	ExpiresAt time.Time
	CreatedAt time.Time
}
