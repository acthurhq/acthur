// Package observability is generated by Acthur's "observability" plugin.
// It instruments every request with Prometheus counters/histograms and
// exposes them at GET /metrics — the metrics pillar of PRD §28's
// OpenTelemetry three-pillar model.
package observability

import (
	"strconv"
	"time"

	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/adaptor"
	"github.com/prometheus/client_golang/prometheus"
	"github.com/prometheus/client_golang/prometheus/promauto"
	"github.com/prometheus/client_golang/prometheus/promhttp"
)

// ServiceName labels every metric this package emits, so a Prometheus
// instance scraping several Acthur services can tell them apart.
const ServiceName = "{{ .NodeID }}"

var (
	requestsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
		Name: "acthur_http_requests_total",
		Help: "Total HTTP requests handled, labeled by service/method/path/status.",
	}, []string{"service", "method", "path", "status"})

	requestDuration = promauto.NewHistogramVec(prometheus.HistogramOpts{
		Name:    "acthur_http_request_duration_seconds",
		Help:    "HTTP request duration in seconds, labeled by service/method/path.",
		Buckets: prometheus.DefBuckets,
	}, []string{"service", "method", "path"})
)

// Middleware records request count + duration for every request. Mount it
// before route registration (via Mount, or directly if you need custom
// ordering relative to other middleware).
func Middleware() fiber.Handler {
	return func(c *fiber.Ctx) error {
		start := time.Now()
		err := c.Next()

		status := c.Response().StatusCode()
		path := c.Route().Path
		if path == "" {
			path = c.Path()
		}
		requestsTotal.WithLabelValues(ServiceName, c.Method(), path, strconv.Itoa(status)).Inc()
		requestDuration.WithLabelValues(ServiceName, c.Method(), path).Observe(time.Since(start).Seconds())

		return err
	}
}

// Mount installs the request-metrics middleware and a GET /metrics
// endpoint serving the default Prometheus registry (adapted from
// net/http via fiber's own adaptor middleware — no extra HTTP server).
func Mount(app *fiber.App) {
	app.Use(Middleware())
	app.Get("/metrics", adaptor.HTTPHandler(promhttp.Handler()))
}
