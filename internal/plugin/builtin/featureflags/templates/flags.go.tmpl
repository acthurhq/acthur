// Package flags is generated by Acthur's "feature-flags" plugin. It is the
// runtime client for whatever flags `acthur flag create/enable/disable`
// manages project-side (backed by .acthur/flags.json) — the dev engine and
// production deploy targets both expose the current flag state to this
// service's process as ACTHUR_FLAG_<NAME>=true|false env vars, so this
// package never touches the filesystem itself; it only reads env.
package flags

import (
	"os"
	"regexp"
	"strings"

	"github.com/gofiber/fiber/v2"
)

var nonAlnum = regexp.MustCompile(`[^A-Z0-9]+`)

// EnvKey returns the ACTHUR_FLAG_<NAME> env var a flag named name is
// exposed under. Mirrors Acthur CLI's internal/flags.EnvKey algorithm
// exactly so a flag toggled via `acthur flag toggle <name>` and read here
// agree on the same key.
func EnvKey(name string) string {
	upper := strings.ToUpper(name)
	collapsed := nonAlnum.ReplaceAllString(upper, "_")
	return "ACTHUR_FLAG_" + strings.Trim(collapsed, "_")
}

// Enabled reports whether the named feature flag is enabled for this
// process. A flag that was never set (no ACTHUR_FLAG_<NAME> env var) is
// treated as disabled — the same "unknown flags are off" default the local
// provider's zero value has.
func Enabled(name string) bool {
	return os.Getenv(EnvKey(name)) == "true"
}

// Registry is the typed set of flags this project's acthur.yml declared for
// this plugin at generation time (plugins: [{name: feature-flags, config:
// {flags: [...]}}]) — a compile-time-checkable list to range over instead
// of hand-typing flag name strings everywhere.
var Registry = []string{
{{- range .Flags }}
	"{{ . }}",
{{- end }}
}

// Require returns a fiber middleware that responds 404 Not Found unless
// the named flag is enabled, gating an entire route (or route group)
// behind a feature flag — the "flag evaluation middleware" the PRD
// describes for this plugin.
func Require(name string) fiber.Handler {
	return func(c *fiber.Ctx) error {
		if !Enabled(name) {
			return fiber.NewError(fiber.StatusNotFound, "not found")
		}
		return c.Next()
	}
}
