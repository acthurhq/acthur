// Package admin is generated by Acthur's "admin" plugin. It mounts a
// read-only operational dashboard for this service: identity/uptime, and
// the project's active feature flags (as exposed to this process via
// ACTHUR_FLAG_<NAME> env vars — see the feature-flags plugin).
package admin

import (
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/gofiber/fiber/v2"
)

// ServiceName is this node's ID, baked in at generation time.
const ServiceName = "{{ .NodeID }}"

var startedAt = time.Now()

// FlagStatus is one feature flag's state as observed from this process's
// environment.
type FlagStatus struct {
	Name    string `json:"name"`
	Enabled bool   `json:"enabled"`
}

// activeFlags scans the process environment for ACTHUR_FLAG_<NAME> vars
// (the convention the dev engine and production deploy targets both use to
// expose feature-flags plugin state) and reports what this process
// currently sees. Read-only by design: flags are toggled via
// `acthur flag toggle <name>`, not through this dashboard — see the
// admin package doc comment on Mount for why.
func activeFlags() []FlagStatus {
	var flags []FlagStatus
	for _, kv := range os.Environ() {
		parts := strings.SplitN(kv, "=", 2)
		if len(parts) != 2 || !strings.HasPrefix(parts[0], "ACTHUR_FLAG_") {
			continue
		}
		name := strings.ToLower(strings.TrimPrefix(parts[0], "ACTHUR_FLAG_"))
		flags = append(flags, FlagStatus{Name: name, Enabled: parts[1] == "true"})
	}
	return flags
}

// Mount installs the admin dashboard at /admin (HTML) and its data at
// /admin/api/status and /admin/api/flags (JSON).
//
// Honest scope: the PRD describes "auto-generates admin panel from graph
// and contracts... a data management interface for all models without
// manual UI work" — i.e. a full CRUD editor over a project's arbitrary
// database models. Acthur has no generic ORM/model-introspection layer
// today (migrations plugin manages schema *versioning*, not a model
// registry a generic UI could read/write against), so a real "edit any
// row of any table" admin editor isn't buildable honestly yet — building
// one would mean inventing throwaway per-database-adapter reflection this
// plugin has no contract for. What IS implemented, and real: a live
// dashboard over the models Acthur itself owns and can introspect safely
// — this service's identity/uptime, and its feature-flag state. See the
// status note in docs/implementation/active/0007-prd-completion.md for
// this descope decision.
func Mount(app *fiber.App) {
	app.Get("/admin", func(c *fiber.Ctx) error {
		c.Set(fiber.HeaderContentType, fiber.MIMETextHTMLCharsetUTF8)
		return c.SendString(dashboardHTML())
	})
	app.Get("/admin/api/status", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{
			"service":         ServiceName,
			"uptime_seconds":  int(time.Since(startedAt).Seconds()),
		})
	})
	app.Get("/admin/api/flags", func(c *fiber.Ctx) error {
		return c.JSON(activeFlags())
	})
}

func dashboardHTML() string {
	var rows strings.Builder
	for _, f := range activeFlags() {
		state := "disabled"
		if f.Enabled {
			state = "enabled"
		}
		rows.WriteString("<tr><td>" + f.Name + "</td><td>" + state + "</td></tr>")
	}
	uptime := strconv.Itoa(int(time.Since(startedAt).Seconds()))
	return `<!doctype html><html><head><title>` + ServiceName + ` — Acthur Admin</title></head>` +
		`<body><h1>` + ServiceName + `</h1><p>uptime: ` + uptime + `s</p>` +
		`<h2>Feature Flags</h2><table border="1"><tr><th>Name</th><th>State</th></tr>` + rows.String() + `</table>` +
		`</body></html>`
}
