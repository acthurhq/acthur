// Package security is generated by Acthur's "security" plugin. It mounts
// fiber's own well-tested middleware for headers, CORS, and rate limiting
// — this package's job is wiring them with Acthur's defaults and, where
// possible, real data derived from the project's graph (a real CORS
// allowlist, not a wildcard).
package security

import (
	"time"

	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/cors"
	"github.com/gofiber/fiber/v2/middleware/helmet"
	"github.com/gofiber/fiber/v2/middleware/limiter"
)

// AllowedOrigins is the CORS allowlist for this service, resolved at
// generation time. When the project graph has data_flow edges into this
// node, this list is exactly those callers' dev URLs (PRD §18.2: "derived
// from graph edges... never wildcards"). Otherwise it falls back to the
// plugin's "allowed_origins" config, or is empty (no cross-origin access)
// — regenerate (`acthur add security`) after adding data_flow edges or
// config to pick up new origins.
var AllowedOrigins = []string{
{{- range .AllowedOrigins }}
	"{{ . }}",
{{- end }}
}

// RateLimitMax and RateLimitWindow configure the per-IP limiter. Defaults
// to {{ .RateLimitMax }} requests per {{ .RateLimitWindowSeconds }}s;
// override via the plugin's "rate_limit_max" / "rate_limit_window_seconds"
// config keys.
const (
	RateLimitMax           = {{ .RateLimitMax }}
	RateLimitWindowSeconds = {{ .RateLimitWindowSeconds }}
)

// Mount installs, in order: security headers (helmet — CSP, X-Frame-Options,
// X-Content-Type-Options, Referrer-Policy, Permissions-Policy, and HSTS
// when served over TLS), CORS restricted to AllowedOrigins, and a per-IP
// rate limiter. Call this once, before any route registration, so every
// route is covered.
func Mount(app *fiber.App) {
	app.Use(helmet.New(helmet.Config{
		ContentSecurityPolicy: "default-src 'self'",
		XFrameOptions:         "DENY",
		ReferrerPolicy:        "strict-origin-when-cross-origin",
		PermissionPolicy:      "camera=(), microphone=(), geolocation=()",
		HSTSMaxAge:            31536000,
		// HSTSExcludeSubdomains defaults to false, i.e. subdomains ARE
		// included — matching the PRD's "includeSubDomains" requirement.
	}))

	if len(AllowedOrigins) > 0 {
		app.Use(cors.New(cors.Config{
			AllowOrigins:     joinOrigins(AllowedOrigins),
			AllowMethods:     "GET,POST,PUT,PATCH,DELETE,OPTIONS",
			AllowHeaders:     "Origin,Content-Type,Authorization,X-Request-ID,X-Tenant-ID",
			AllowCredentials: true,
			MaxAge:           86400,
		}))
	}

	app.Use(limiter.New(limiter.Config{
		Max:        RateLimitMax,
		Expiration: RateLimitWindowSeconds * time.Second,
		KeyGenerator: func(c *fiber.Ctx) string {
			return c.IP()
		},
	}))
}

func joinOrigins(origins []string) string {
	out := origins[0]
	for _, o := range origins[1:] {
		out += "," + o
	}
	return out
}
